PORT=3000
# Deploy integrations/google-sheets/Code.gs, then paste the /exec web app URL here.
INQUIRY_SHEETS_URL=
# Secret is server-only. Never use a VITE_ prefix or commit your .env file.
# The Apps Script CONFIG.secretHash must match SHA-256 of this secret.
INQUIRY_SHEETS_SECRET=
# Optional when the API and frontend are hosted on different origins:
# FRONTEND_ORIGIN=https://your-frontend.example
# VITE_API_URL=https://your-api.example
# TRUST_PROXY=1
# NODE_ENV=production
